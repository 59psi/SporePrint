# SporePrint Configuration
# Copy to .env and fill in your values: cp .env.example .env
# On a Pi, ./install.sh does this for you (it only fills keys that are unset)
# and docker compose reads THIS file (the repo-root .env). A setting reaches
# the server container only if docker-compose.yml's server `environment:`
# list names it. After editing, apply with `docker compose up -d` —
# `docker compose restart` does not re-read .env.
#
# Bare metal (uvicorn run from server/) reads server/.env instead. Only the
# SPOREPRINT_* settings take effect there; other keys (TZ, the compose-only
# ones below) are ignored, so set TZ in the service's own environment. A
# blank value for a number/true-false/choice setting means its default.

# Time zone for automation schedules (photoperiod, time windows, cron), which
# run on the server's local clock. install.sh writes the host's zone here.
# Use a canonical Region/City name (America/Los_Angeles, not US/Pacific): the
# server image carries canonical zones only, and an unknown zone silently
# runs on UTC. Empty = UTC. Changing it shifts every schedule.
TZ=

# Database
SPOREPRINT_DATABASE_PATH=data/db/sporeprint.db

# MQTT Broker — credentials generated by install.sh on first run (setup.sh on
# a dev workstation). If blank, the Pi connects anonymously; that only works
# when the broker also has allow_anonymous=true (development). Production
# always uses credentials. Rotate with scripts/rotate-mqtt-creds.sh.
SPOREPRINT_MQTT_HOST=localhost
SPOREPRINT_MQTT_PORT=1883
SPOREPRINT_MQTT_USERNAME=
SPOREPRINT_MQTT_PASSWORD=

# Smart-plug broker credential (user sp-3p), generated by install.sh. Enter it
# in each Shelly/Tasmota plug's MQTT settings (Tasmota also needs FullTopic
# tasmota/%topic%/%prefix%/ and a unique Topic). Not read by the server.
# SPOREPRINT_MQTT_3P_PASSWORD=

# MQTT command signing (HMAC over every cmd/* frame). install.sh generates the
# key here on first run (reusing one an older provision-node.sh left in
# server/.env); print or rotate it with ./scripts/provision-node.sh. With a
# key the Pi signs every command: nodes that have no key accept signed
# commands (with a warning), and each node you give the key to — portal field
# "Command signing key" — rejects unsigned or forged ones. WITHOUT a key, a
# cloud-paired Pi (auto mode) refuses to send ANY node command.
#   SPOREPRINT_MQTT_REQUIRE_SIGNING: auto (enforce when cloud-paired) |
#   always | never. Must not be left empty.
SPOREPRINT_MQTT_HMAC_KEY=
SPOREPRINT_MQTT_REQUIRE_SIGNING=auto

# Notifications (ntfy) — the ntfy BASE URL (the topic is separate). Docker
# always uses http://ntfy:80.
SPOREPRINT_NTFY_URL=http://localhost:8080
SPOREPRINT_NTFY_TOPIC=sporeprint

# Vision
SPOREPRINT_VISION_STORAGE=data/vision
# Claude auto-analysis cadence per grow session, in minutes (default 360 =
# every 6 h, plus the first frame after each phase change). The local CNN is
# still a stub, so this is also the worst-case automatic contamination
# detection latency: lower detects sooner and costs more Claude API spend.
# SPOREPRINT_VISION_AUTO_INTERVAL_MIN=360

# Claude API (required for vision analysis + builder's assistant)
SPOREPRINT_CLAUDE_API_KEY=
# Model for every Claude feature (vision, contamination identify, transcript
# and experiment analysis, Builder's Assistant). Blank = the server default.
# SPOREPRINT_CLAUDE_MODEL=claude-sonnet-5

# Weather (default: Open-Meteo, no key needed — just set lat/lon)
# Providers: "openmeteo" (default, free), "openweathermap" (needs key), "nws" (US only, free)
SPOREPRINT_WEATHER_PROVIDER=openmeteo
SPOREPRINT_WEATHER_API_KEY=
SPOREPRINT_WEATHER_LAT=
SPOREPRINT_WEATHER_LON=
SPOREPRINT_WEATHER_POLL_MINUTES=10

# Cloud connector (opt-in — for mobile app remote access). Pairing from the
# app stores its credentials in cloud.env next to the database (Docker: the
# sporeprint_db volume), and those override these; delete that file to
# unpair. A paired Pi enforces command signing (see SPOREPRINT_MQTT_HMAC_KEY).
SPOREPRINT_CLOUD_URL=
SPOREPRINT_CLOUD_TOKEN=
SPOREPRINT_CLOUD_DEVICE_ID=
# Reject unsigned cloud integrations_request frames from the start (default
# false: they are refused once the Pi has verified its first signed one).
# SPOREPRINT_CLOUD_REQUIRE_SIGNED_INTEGRATIONS=false

# OTA self-update verify key (base64 Ed25519 public key from
# scripts/generate-ota-keypair.py; SPOREPRINT_OTA_PUBKEY is the older name).
# Also settable in the UI: Settings → OTA verify key. Only bare-metal installs
# self-update — the Docker install refuses cloud OTA; update it with
# `git pull && ./install.sh`.
SPOREPRINT_OTA_PUBKEY_B64=
# Each release is checked against its signed manifest (version, channel,
# sha256, size). The Pi installs only releases from its own channel
# (stable | beta | dev) and never an older version than it runs, unless
# ALLOW_DOWNGRADE is set here (the cloud cannot set it). ALLOW_LEGACY_SIGNATURE
# accepts a release that has only the old bundle signature and no manifest
# (transitional; version and channel are then unsigned).
# SPOREPRINT_OTA_CHANNEL=stable
# SPOREPRINT_OTA_ALLOW_DOWNGRADE=false
# SPOREPRINT_OTA_ALLOW_LEGACY_SIGNATURE=false

# HTTP auth. The bundled browser dashboard calls /api same-origin WITHOUT a
# bearer token, so the default is LAN-trust: install.sh / setup.sh add
# SPOREPRINT_ALLOW_UNAUTHENTICATED=true when no API key is set (keep the Pi
# behind your router; never port-forward it). Setting SPOREPRINT_API_KEY makes
# every /api/* request and Socket.IO connect require
# `Authorization: Bearer <SPOREPRINT_API_KEY>` — for the mobile app /
# external clients — and the browser dashboard then stops working.
# See docs/auth.md.
SPOREPRINT_API_KEY=

# Where browsers reach the dashboard — used for links on printed QR labels
# when the request itself names no origin. Set it to http://<pi-ip>:3001 if
# sporeprint.local does not resolve on your network. Its host is also always
# an allowed Host name (below).
# SPOREPRINT_PUBLIC_UI_URL=http://sporeprint.local:3001

# DNS-rebinding guard. The API (and Socket.IO) answers only for Host names a
# web page elsewhere cannot point at your Pi: private/loopback/link-local/
# CGNAT (Tailscale 100.x) IP addresses, localhost, *.local, *.lan, *.home,
# *.home.arpa, *.internal, *.localdomain, names without a dot (e.g.
# raspberrypi) and the host of SPOREPRINT_PUBLIC_UI_URL. Any other name gets
# "421 Misdirected Request". If you reach the Pi by another name (a Tailscale
# MagicDNS name, your own domain), list it here — comma separated; "*.ts.net"
# style wildcards, IP addresses and CIDRs work too. "*" disables the check.
# A camera whose portal "Pi host" is such a name needs it listed as well.
# See docs/auth.md.
# SPOREPRINT_ALLOWED_HOSTS=pi.example.net,*.ts.net

# Server (bare metal — under Docker, uvicorn always binds 0.0.0.0:8000)
SPOREPRINT_HOST=0.0.0.0
SPOREPRINT_PORT=8000

# Docker network between the ui (nginx) and the server. uvicorn trusts
# X-Forwarded-For only from the ui container's address, so each dashboard's
# real address reaches the server and nobody else can forge one. Change these
# only if `docker compose up` reports "Pool overlaps with other one on this
# address space" — all four together, FORWARDED_ALLOW_IPS = the ui address.
# SPOREPRINT_EDGE_SUBNET=172.31.253.0/28
# SPOREPRINT_EDGE_UI_IP=172.31.253.2
# SPOREPRINT_EDGE_SERVER_IP=172.31.253.3
# FORWARDED_ALLOW_IPS=172.31.253.2
